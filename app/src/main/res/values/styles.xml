<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="calcs_bg">#EEF1F5</color>
    <color name="calcs_bar">#FFFFFF</color>
    <color name="calcs_accent">#1F6FD1</color>
    <color name="icon_bg">#1F2A36</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/calcs_bar</item>
        <item name="android:colorPrimaryDark">@color/calcs_bar</item>
        <item name="android:colorAccent">@color/calcs_accent</item>
        <item name="android:windowBackground">@color/calcs_bg</item>
        <item name="android:statusBarColor">@color/calcs_bar</item>
        <item name="android:navigationBarColor">@color/calcs_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
